{
    "name": "specflux/agent-safety-core",
    "description": "Server-side governance core for AI-agent tool calls: verb-tier classification, capability packs, gate decisions, and compliance-grade audit. Framework-agnostic; consumed by the agent-safety plugin. WooCommerce is supported as a capability pack, not a hard dependency.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^7.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Specflux\\AgentSafety\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Specflux\\AgentSafety\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "test:plugin": "phpunit -c plugin/phpunit.xml.dist",
        "check": [
            "@lint",
            "@phpstan",
            "@test",
            "@test:plugin"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
